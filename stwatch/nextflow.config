// stwatch configuration.
// the version and module names are defined here
manifest {
    name            = 'stwatch'
    author          = 'DYNAMR'
    description     = 'Type bacterial assemblies with mlst; flag novel and high-risk STs; build an HTML report'
    version         = '1.0.0'                 // bump this for a release
    nextflowVersion = '>=23.04.0'
}

params {
    // Pipeline inputs / outputs
    input          = null                     // required: quoted glob of assemblies
    output         = 'mlst_results'
    
    modules        = 'Nextflow mlst Python' // preload the modules
}
